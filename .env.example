APP_ENV=local
APP_NAME=Enterprise Retention Agent
STREAMLIT_API_GET_TIMEOUT_SECONDS=30
STREAMLIT_API_TIMEOUT_SECONDS=360
DATABASE_PATH=artifacts/retention.db
MODEL_PATH=artifacts/models/churn_model.joblib
MODEL_METADATA_PATH=artifacts/models/churn_model_metadata.json
RAW_HISTORY_DATA_PATH=data/raw/customer_history.csv
RAW_CURRENT_DATA_PATH=data/raw/current_customers.csv
KNOWLEDGE_DIR=data/knowledge
GOLDEN_DATASET_PATH=data/golden/customer_retention_cases.jsonl
AGENT_PROVIDER=deterministic
AGENT_SKILLS_DIR=skills
AGENT_SKILL_MAX_RESOURCE_BYTES=100000
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-06-01
AZURE_OPENAI_TIMEOUT_SECONDS=120
ALLOW_DETERMINISTIC_FALLBACK=true
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1500
# lean = compact prompt, no tool/skill round trips (fast); full = complete context + tools + skills
LLM_PROMPT_MODE=lean
LLM_NUM_CTX=8192
LLM_TIMEOUT_SECONDS=240
RETRIEVAL_BACKEND=lexical
RETRIEVAL_EMBEDDING_PROVIDER=azure_openai
RETRIEVAL_CHROMA_PERSIST_PATH=artifacts/chroma
RETRIEVAL_CHROMA_COLLECTION=retention_knowledge
RETRIEVAL_AZURE_OPENAI_ENDPOINT=
RETRIEVAL_AZURE_OPENAI_API_KEY=
RETRIEVAL_AZURE_OPENAI_DEPLOYMENT=text-embedding-3-large
RETRIEVAL_AZURE_OPENAI_API_VERSION=2024-02-15-preview
RETRIEVAL_AZURE_OPENAI_TIMEOUT_SECONDS=30
MLFLOW_TRACKING_URI=http://127.0.0.1:5001
MLFLOW_EXPERIMENT_NAME=enterprise-retention-agent
ENABLE_MLFLOW=false
MLFLOW_USE_MODEL_REGISTRY=false
MLFLOW_REGISTERED_MODEL_NAME=b2b-ai-copilot-churn-risk-model
MLFLOW_DEPLOYMENT_ALIAS=champion
LOG_LEVEL=INFO
